// -----------------------------------------------------------------------------
// Engine bootstrap materials.
//
// The commercial data package normally supplies these declarations.  St. Brielle
// defines its own minimal versions using only renderer-generated images so the
// standalone source build can initialize without Skin Deep assets.
// -----------------------------------------------------------------------------

_default
{
	{
		map			_default
	}
}

_white
{
	{
		map			_white
	}
}

_tracemodel
{
	noShadows
}

console
{
	noShadows
	{
		blend		blend
		map			_black
		rgb			0.08
		alpha		1
	}
}

wipeMaterial
{
	noShadows
	{
		blend		blend
		alpha		parm3
		map			_black
		scale		1, -1
		translate	0, -1
	}
}

wipe2Material
{
	noShadows
	{
		blend		blend
		map			_black
		scale		1, -1
		translate	0, -1
		alpha		1.0 - parm3
	}
}

textures/bigchars
{
	// The commercial font atlas is not part of the public source release.
	// Keep console glyph quads invisible in the standalone bootstrap instead
	// of drawing each character as a solid debug rectangle.
	noShadows
	{
		blend		blend
		map			_white
		rgba		0
	}
}

lights/defaultPointLight
{
	lightFalloffImage	_noFalloff
	{
		map			_white
		colored
	}
}

lights/defaultProjectedLight
{
	lightFalloffImage	_noFalloff
	{
		map			_white
		colored
	}
}

// Minimal original development materials for St. Brielle.
// These use engine-provided internal images so the Record lab does not require
// any commercial Skin Deep texture files.

textures/stbrielle/dev_wall
{
	qer_editorimage	_white
	{
		map			_white
		color		0.44, 0.46, 0.5, 1
	}
}

